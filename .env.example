# 30 MPS Growth OS — entorno
# Copia a .env.local y rellena. Sin Supabase, el Hub usa persistencia local (navegador).

# local | supabase
VITE_DATA_MODE=local

# Postgres vía Supabase (Fase 1 Data Hub en la nube)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

